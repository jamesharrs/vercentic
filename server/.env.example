ANTHROPIC_API_KEY=your_key_here
ANTHROPIC_API_KEY=your_key_here

# ── Security (REQUIRED in production) ────────────────────────────────────────
# Random 32+ character string used to encrypt integration credentials at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: changing this value will invalidate all stored integration credentials.
INTEGRATION_SECRET=generate_a_random_32_char_string_here

# Session secret for express-session (REQUIRED in production)
SESSION_SECRET=generate_another_random_32_char_string_here

# Cookie domain for cross-subdomain auth (set to .vercentic.com in production)
COOKIE_DOMAIN=.vercentic.com

# Shared secret for trusted machine-to-machine calls with no user session —
# currently used by the deploy pipeline (scripts/generate-release-note.js,
# run from .github/workflows/deploy-production.yml) to draft a "What's New"
# release note after a production deploy, via the `x-internal-key` header.
# Must match the INTERNAL_API_KEY GitHub Actions repo secret.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=generate_a_random_32_char_string_here
